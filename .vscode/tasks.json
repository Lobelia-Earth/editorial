{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start all (local)",
      "dependsOn": ["docs-start"]
    },
    {
      "label": "docs-start",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "start"],
      "options": {
        "cwd": "${workspaceFolder}/docs"
      },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
