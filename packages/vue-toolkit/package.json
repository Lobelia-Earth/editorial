{
  "name": "@isardsat/editorial-vue-toolkit",
  "version": "6.29.0",
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "prepublishOnly": "pnpm --filter @isardsat/editorial-common compile && pnpm run build",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "vue": "^3.3"
  },
  "devDependencies": {
    "@isardsat/editorial-common": "workspace:^",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vue": "^3.5.25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lobelia-Earth/editorial"
  },
  "keywords": [
    "editorial",
    "vue",
    "api",
    "adapter"
  ]
}
